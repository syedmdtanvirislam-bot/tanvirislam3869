{
  "entities": {
    "userProfile": {
      "title": "User Profile",
      "description": "Stores user preferences and progress",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "theme": { "type": "string", "enum": ["light", "dark"] },
        "lastActive": { "type": "string", "format": "date-time" },
        "role": { "type": "string", "enum": ["user", "admin"] }
      },
      "required": ["uid", "email"]
    },
    "userProgress": {
      "title": "User Progress",
      "description": "Tracks chapter completion and quiz scores",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "completedChapters": { "type": "array", "items": { "type": "string" } },
        "quizScores": { 
          "type": "object", 
          "description": "Map of quizId to best score"
        },
        "totalPoints": { "type": "number" }
      },
      "required": ["uid"]
    },
    "note": {
      "title": "User Note",
      "description": "Personal notes on study topics",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": "string" },
        "topicId": { "type": "string" },
        "content": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "topicId", "content"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "userProfile",
      "description": "User profile data"
    },
    "/progress/{userId}": {
      "schema": "userProgress",
      "description": "User learning progress"
    },
    "/notes/{noteId}": {
      "schema": "note",
      "description": "User study notes"
    }
  }
}
